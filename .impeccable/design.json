      "refersTo": "button-ghost",
      "description": "Secondary actions beside the main invitation.",
      "html": "<button class=\"ds-ghost\">Ask again</button>",
      "css": ".ds-ghost{font-family:var(--sans,'Avenir Next','PingFang SC','Microsoft YaHei',sans-serif);display:block;width:100%;border:0;border-radius:18px;padding:16px 24px;font-size:15px;font-weight:500;line-height:1.5;letter-spacing:.08em;cursor:pointer;transition:background .25s,transform .4s cubic-bezier(.16,1,.3,1);border:1px solid #ae8f9f;background:#fffdf6;color:#624d46}.ds-ghost:hover{background:#f7eee4;transform:translateY(-2px)}.ds-ghost:focus-visible{outline:2px solid #94665c;outline-offset:5px;}.ds-ghost:active{transform:scale(.98)}.ds-ghost:disabled{opacity:.5;transform:none;cursor:default}@media(prefers-reduced-motion:reduce){.ds-ghost{transition:none}}"
    },
    {
      "name": "Question field",
      "kind": "input",
      "refersTo": "question-field",
      "description": "A personal question written on translucent paper.",
      "html": "<label class=\"ds-field-label\" for=\"ds-question\">Your question</label><textarea class=\"ds-question\" id=\"ds-question\" placeholder=\"What is on your mind?\"></textarea>",
      "css": ".ds-field-label{font-family:var(--sans,'Avenir Next','PingFang SC','Microsoft YaHei',sans-serif);display:block;color:var(--muted,#806961);font-size:12px;margin-bottom:8px}.ds-question{font-family:var(--serif,OracleSerif,'Songti SC',STSong,Georgia,serif);display:block;box-sizing:border-box;width:100%;min-height:160px;padding:20px;border:1px solid #ddc6ba;border-radius:3px;background:#f8f3f34d;color:var(--ink,#554641);font-size:25px;font-weight:400;line-height:1.35;resize:none;caret-color:#94665c;transition:border-color .2s}.ds-question::placeholder{color:#8f756a;font-style:italic}.ds-question:focus,.ds-question:focus-visible{border-color:#946b5c;outline:2px solid #d6b9a944;outline-offset:3px}.ds-question:disabled{opacity:.6}@media(prefers-reduced-motion:reduce){.ds-question{transition:none}}"
    },
    {
      "name": "Masthead navigation",
      "kind": "nav",
      "refersTo": "language-control",
      "description": "Home wordmark with music and language actions; 44px utility targets.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Oracle\"><button class=\"ds-home\">Oracle</button><div class=\"ds-tools\"><button class=\"ds-music\" aria-label=\"Background music\" aria-pressed=\"true\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 18.5a2.5 2.5 0 1 1-2-2.45V5l11-2v12.5a2.5 2.5 0 1 1-2-2.45V7.1l-7 1.3z\"/></svg></button><button class=\"ds-lang\" aria-label=\"Switch language\">中文</button></div></nav>",
      "css": ".ds-nav{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-bottom:20px;border-bottom:1px solid #d4bcb16b;color:var(--ink,#554641)}.ds-home{font-family:var(--serif,OracleSerif,'Songti SC',STSong,Georgia,serif);font-size:48px;line-height:1;font-style:italic;letter-spacing:-.035em;background:none;border:0;padding:0;color:inherit;cursor:pointer}.ds-tools{display:flex;gap:9px}.ds-music,.ds-lang{font-family:var(--sans,'Avenir Next','PingFang SC','Microsoft YaHei',sans-serif);min-width:44px;min-height:44px;border:1px solid #d8bfb2;background:#f7f1f040;color:inherit;cursor:pointer}.ds-music{width:44px;height:44px;border-radius:50%;display:grid;place-items:center}.ds-music svg{width:17px;height:17px;fill:#906c5e}.ds-music[aria-pressed=true]{background:#ecdbce}.ds-lang{border-radius:99px;padding:5px 14px;font-size:12px}.ds-home:hover,.ds-music:hover,.ds-lang:hover{opacity:.85}.ds-home:focus-visible,.ds-music:focus-visible,.ds-lang:focus-visible{outline:2px solid #94665c;outline-offset:5px;}.ds-home:active,.ds-music:active,.ds-lang:active{opacity:.7}@media(max-width:900px){.ds-nav{gap:14px;padding-bottom:14px}.ds-home{font-size:40px}.ds-tools{gap:6px}}"
