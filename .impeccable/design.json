  "narrative": {
    "northStar": "银粉祈愿笺 · Silver-Rose Vellum",
    "overview": "Warm pale pink paper, ivory rounded actions, floral lace and polka dots. Decorative small copy is removed while task instructions and readings remain clear.",
    "keyCharacteristics": [
      "Silver-rose paper with dark plum text.",
      "Floral tulle, lace and fine polka dots as material.",
      "Quiet orbital geometry and slow breathing motion.",
      "Serif ritual typography paired with clear bilingual controls."
    ],
    "rules": [
      {
        "name": "The Pale Material Rule",
        "body": "Keep texture and celestial ornament behind dark, readable content; the material supplies atmosphere rather than text contrast.",
        "section": "colors"
      },
      {
        "name": "The Upright Chinese Rule",
        "body": "Do not synthesize italic Chinese. Chinese mode explicitly removes italics from every element.",
        "section": "typography"
      },
      {
        "name": "The Quiet Ritual Rule",
        "body": "Use slow decorative motion and graceful state changes; honor reduced motion by disabling animation and transitions.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the grey-pink, lace, polka-dot and divinity commitments together.",
      "Do use the final local font stacks and upright Songti for Chinese.",
      "Do keep music and language controls at least 44px in both dimensions.",
      "Do preserve the 900px layout transition and readable text above decoration.",
      "Do reuse the existing floral veil, dotted tulle and lace assets for material detail."
    ],
    "donts": [
      "Don't restore the superseded midnight-blue and yellow-gold palette.",
      "Don't turn fine paper edges into generic rounded dashboard cards.",
      "Don't use pale decorative rose as the only readable foreground.",
      "Don't add fast ambient motion or ignore reduced-motion preferences."
    ]
  }
}
