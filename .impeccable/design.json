    {
      "name": "Primary invitation",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The principal action, used to enter or continue the ritual.",
      "html": "<button class=\"ds-primary\">Ask the oracle</button>",
      "css": ".ds-primary{font-family:var(--sans,'Avenir Next','PingFang SC','Microsoft YaHei',sans-serif);display:block;width:100%;border:0;border-radius:18px;padding:16px 24px;font-size:15px;font-weight:500;line-height:1.5;letter-spacing:.08em;cursor:pointer;transition:background .25s,transform .4s cubic-bezier(.16,1,.3,1);background:#fffdf6;color:#624d46;box-shadow:0 8px 20px -12px #947361}.ds-primary:hover{background:#f5eee2;transform:translateY(-2px)}.ds-primary:focus-visible{outline:2px solid #94665c;outline-offset:5px;}.ds-primary:active{transform:scale(.98)}.ds-primary:disabled{opacity:.5;transform:none;cursor:default}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
